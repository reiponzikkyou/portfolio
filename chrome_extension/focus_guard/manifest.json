{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "1.3",
  "description": "設定した時間帯にSNSを開くと、警告画像を出してタブを閉じさせます。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.instagram.com/*",
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["*.png", "*.jpg", "*.jpeg", "*.gif"],
      "matches": ["<all_urls>"]
    }
  ]
}